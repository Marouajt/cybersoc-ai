# ---------------------------------------------------------------------------
# CyberSOC AI — modèle de configuration locale.
# Copier en `.env` :   cp .env.example .env     (PowerShell : Copy-Item .env.example .env)
# `.env` n'est JAMAIS commité (voir .gitignore).
# ---------------------------------------------------------------------------

# --- Neo4j (étape 0 / étape 4) -------------------------------------------
NEO4J_USER=neo4j
# Mot de passe local uniquement. 8 caractères minimum imposés par Neo4j.
NEO4J_PASSWORD=changeme_local
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j
NEO4J_HTTP=http://localhost:7474

# --- MLflow (étape 10, profil "ops") ------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_PREFIX=cybersoc

# --- Langfuse (étape 10, optionnel) -------------------------------------
# Renseigner après avoir lancé la stack Langfuse (voir docs/DECISIONS.md, ADR-0004).
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Application (étapes 7, 8, 11) --------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=local

# --- Modèles (étapes 2, 5, 6) -------------------------------------------
# Modèles pressentis par la feuille de route ; à figer à l'étape 2.
SLM_PRIMARY=Qwen/Qwen2.5-3B-Instruct
SLM_SECONDARY=microsoft/Phi-3.5-mini-instruct
MODEL_DIR=./models/weights
HF_HOME=./models/weights/.hf

# --- Reproductibilité ----------------------------------------------------
# Graine globale utilisée par tout script générant des données ou échantillonnant.
RANDOM_SEED=42
